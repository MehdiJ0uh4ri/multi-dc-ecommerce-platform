<mxfile host="drawio" type="device"><diagram id="multi-dc-platform" name="Architecture"><mxGraphModel dx="2000" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;multi-dc-platform&lt;/b&gt; — e-commerce data platform on k3d (Phases 0–3 built, Phase 4 planned)&lt;br&gt;&lt;span style='font-size:12px;color:#5A6C86'&gt;AWS-style notation for a local k3d cluster: each icon is the closest AWS equivalent; labels name what actually runs. Snapshot 2026-09-15.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1500" height="60" as="geometry"/></mxCell><mxCell id="host" value="Developer host · Linux · 4 CPU / 15 GiB RAM · Docker Engine" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1980" height="1340" as="geometry"/></mxCell><mxCell id="client" value="Browser / curl / kubectl" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="host"><mxGeometry x="110" y="60" width="70" height="70" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;━━ &lt;b&gt;solid&lt;/b&gt;: verified working&lt;br&gt;&lt;font color='#ED7100'&gt;┅┅ &lt;b&gt;orange dashed&lt;/b&gt;: fix written, not applied&lt;/font&gt;&lt;br&gt;&lt;font color='#687078'&gt;┅┅ &lt;b&gt;grey dashed&lt;/b&gt;: planned (Phase 4)&lt;/font&gt;&lt;br&gt;&lt;font color='#248814'&gt;┈┈ &lt;b&gt;green dotted&lt;/b&gt;: operator reconcile / IaC control&lt;/font&gt;&lt;br&gt;&lt;font color='#D13212'&gt;&lt;b&gt;red label&lt;/b&gt;: failing or disabled&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Notation → real component&lt;/b&gt;&lt;br&gt;Corporate data center → developer host&lt;br&gt;VPC → Docker network k3d-multidc&lt;br&gt;Region → k3d cluster &lt;i&gt;multidc&lt;/i&gt;&lt;br&gt;Availability Zone → k3s node (simulated DC)&lt;br&gt;Subnet → Kubernetes namespace&lt;br&gt;ELB → k3d load balancer (nginx)&lt;br&gt;ECR → k3d registry:2&lt;br&gt;EKS → k3s control plane&lt;br&gt;API Gateway → Apache APISIX&lt;br&gt;Cognito → Keycloak&lt;br&gt;ECS task → Spring Boot service pod&lt;br&gt;RDS → PostgreSQL (CloudNativePG)&lt;br&gt;MSK → Kafka / Kafka Connect (Strimzi)&lt;br&gt;Keyspaces → Apache Cassandra&lt;br&gt;OpenSearch → Elasticsearch · DocumentDB → MongoDB&lt;br&gt;Amazon MQ → RabbitMQ · S3 → MinIO&lt;br&gt;CloudFormation → Terraform · SSM → Ansible" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F8F9FA;strokeColor=#AAB7B8;fontSize=11;arcSize=4;" vertex="1" parent="host"><mxGeometry x="20" y="200" width="280" height="600" as="geometry"/></mxCell><mxCell id="iac" value="Infrastructure as Code (this repo)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FDF2F8;strokeColor=#E7157B;fontStyle=1;fontSize=12;container=1;collapsible=0;arcSize=4;" vertex="1" parent="host"><mxGeometry x="20" y="830" width="280" height="480" as="geometry"/></mxCell><mxCell id="terraform" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;kubernetes + he